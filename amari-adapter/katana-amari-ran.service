[Unit]
Description=Katana Amari RAN Adapter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/katana/amari-adapter/server.py --component ran --port 8081 --state-file /var/lib/katana-amari-adapter/ran-slices.json --dry-run
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
